<!DOCTYPE html>
<html lang="zh-Hant">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cyberpi 第三方網頁控制端</title>
    <!-- 引入 MQTT.js 庫，讓 HTML 網頁支援 MQTT 通訊 -->
    <script src="https://unpkg.com"></script>
    <style>
        body { font-family: Arial, sans-serif; text-align: center; margin-top: 50px; background-color: #f4f4f9; }
        h1 { color: #333; }
        .btn { padding: 15px 30px; font-size: 18px; margin: 10px; cursor: pointer; border: none; border-radius: 5px; color: white; transition: 0.2s; }
        .btn-green { background-color: #4CAF50; }
        .btn-red { background-color: #f44336; }
        .btn-blue { background-color: #008CBA; }
        .btn:hover { opacity: 0.8; }
        #status { margin-top: 20px; font-weight: bold; color: #666; }
    </style>
</head>
<body>

    <h1>Cyberpi 待定行動控制面板</h1>
    <p>透過 HTML 網頁發送訊號至 Cyberpi</p>

    <!-- 控制按鈕 -->
    <button class="btn btn-green" onclick="sendSignal('ACTION_1')">執行行動一 (綠燈)</button>
    <button class="btn btn-red" onclick="sendSignal('ACTION_2')">執行行動二 (紅燈)</button>
    <button class="btn btn-blue" onclick="sendSignal('STOP')">停止所有行動</button>

    <div id="status">正在連接到 MQTT 伺服器...</div>

    <script>
        // 連接到公開的 MQTT Broker (使用 WebSocket 埠號 8084 支援加密連線)
        const broker = 'wss://://hivemq.com';
        const topic = 'cyberpi/device1/command'; // 必須與 Cyberpi 訂閱的名稱完全相同
        const client = mqtt.connect(broker);

        const statusDiv = document.getElementById('status');

        client.on('connect', () => {
            statusDiv.innerText = '狀態：已成功連接伺服器，可以發送訊號！';
            statusDiv.style.color = 'green';
        });

        client.on('error', (err) => {
            statusDiv.innerText = '連線失敗: ' + err;
            statusDiv.style.color = 'red';
        });

        // 發送訊號的語法
        function sendSignal(action) {
            if (client.connected) {
                client.publish(topic, action);
                statusDiv.innerText = `發送訊號成功：${action}`;
                statusDiv.style.color = '#333';
            } else {
                alert('未連接到伺服器，無法發送訊號！');
            }
        }
    </script>
</body>
</html>
